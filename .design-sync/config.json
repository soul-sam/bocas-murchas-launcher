{
  "pkg": "bocas-murchas-launcher",
  "globalName": "BocasMurchas",
  "shape": "package",
  "srcDir": "src",
  "tsconfig": ".design-sync/tsconfig.paths.json",
  "cssEntry": ".design-sync/compiled.css",
  "readmeHeader": ".design-sync/conventions.md",
  "buildCmd": "node .design-sync/build-css.mjs",
  "provider": { "component": "TooltipProvider" },
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "760x560" },
    "DropdownMenu": { "cardMode": "single", "viewport": "520x420" },
    "Popover": { "cardMode": "single", "viewport": "560x420" },
    "Tooltip": { "cardMode": "single", "viewport": "460x300" },
    "Hint": { "cardMode": "single", "viewport": "460x300" }
  },
  "componentSrcMap": {
    "Avatar": "src/components/ui/avatar.tsx",
    "UserAvatar": "src/components/ui/avatar.tsx",
    "Button": "src/components/ui/button.tsx",
    "Card": "src/components/ui/card.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "DropdownMenu": "src/components/ui/dropdown-menu.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/label.tsx",
    "Popover": "src/components/ui/popover.tsx",
    "Switch": "src/components/ui/switch.tsx",
    "SwitchRow": "src/components/ui/switch.tsx",
    "Tabs": "src/components/ui/tabs.tsx",
    "Tooltip": "src/components/ui/tooltip.tsx",
    "Hint": "src/components/ui/tooltip.tsx",
    "CardFrame": "src/components/cards/index.tsx",
    "MessageCard": "src/components/cards/index.tsx",
    "SystemCard": "src/components/cards/SystemCard.tsx",
    "ChessResultCard": "src/components/cards/ChessResultCard.tsx",
    "EventCard": "src/components/cards/EventCard.tsx",
    "GameResultCard": "src/components/cards/GameResultCard.tsx",
    "PartyCard": "src/components/cards/PartyCard.tsx",
    "PollCard": "src/components/cards/PollCard.tsx",
    "RecapCard": "src/components/cards/RecapCard.tsx",
    "SuggestionCard": "src/components/cards/SuggestionCard.tsx",
    "WagerCard": "src/components/cards/WagerCard.tsx",
    "WatchCard": "src/components/cards/WatchCard.tsx",
    "InstallStatusCard": "src/components/InstallStatusCard.tsx",
    "MicrosoftAccountCard": "src/components/MicrosoftAccountCard.tsx",
    "PlayCard": "src/components/PlayCard.tsx",
    "ServerStatusCard": "src/components/ServerStatusCard.tsx"
  }
}
